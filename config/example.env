# Base directories
PROJECT_ROOT=/workspace/kirankumarp20
DATA_DIR=${PROJECT_ROOT}/data
RESULTS_DIR=${PROJECT_ROOT}/results
LOG_DIR=${PROJECT_ROOT}/logs

# Reference data
GENOME_FA=/path/to/genome.fa
GENOME_GTF=/path/to/annotation.gtf
STAR_INDEX=/path/to/star_index
SALMON_INDEX=/path/to/salmon_index

# Performance
THREADS=16
MEM_GB=64

# SRA Toolkit
SRA_CACHE=${DATA_DIR}/sra_cache
SRA_TMP=${DATA_DIR}/sra_tmp
